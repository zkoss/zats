<zk>
	<zscript><![CDATA[
		void init() {
			ListModel model = new ListModelList(Collections.nCopies(1000, "item"));
			ListitemRenderer itemRenderer = new ListitemRenderer() {
				public void render(Listitem item, Object data, int index) {
					item.setLabel(data + index);
				}
			};
			RowRenderer rowRenderer = new RowRenderer() {
				public void render(Row row, Object data, int index) {
					new Label(data + "" + index).setParent(row);
				}
			};
			listbox.setModel(model);
			listbox.setItemRenderer(itemRenderer);
			grid.setModel(model);
			grid.setRowRenderer(rowRenderer);
		}
		void show() {
			int i = Integer.parseInt(index.getValue());
			Listitem li = listbox.getItemAtIndex(i);
			listitemContent.setValue(li != null && li.getChildren().size() > 0 ? li.getLabel() : "item" + i + " doesn't render");
			Row row = (Row)grid.getRows().getChildren().get(i);
			rowContent.setValue(row != null && row.getChildren().size() > 0 ? ((Label)row.getChildren().get(0)).getValue() : "item" + i + " doesn't render");
		}
	]]></zscript>
	<vbox>
		<button id="init" label="init" onClick="init()" />
		<hbox>
			index: <textbox id="index" onChange="show()" />
			listitem: <label id="listitemContent" />
			row: <label id="rowContent" />
		</hbox>
		<listbox id="listbox" height="200px" />
		<grid id="grid" height="200px" />
	</vbox>
</zk>
